const CONTROL_SPREADSHEET_ID = '1lvnZTHLTh8eA4f7VoVwSj2bZ-y8tOYDw-KYmylJvZP0';
const MAPPING_SHEET_NAME = '部門人事費用 Mapping 表';

const PERSONNEL_SETTING_SHEET_NAME = '人事費用來源設定';
const PERSONNEL_SOURCE_ID_COLUMN = '人事費用 Spreadsheet ID';
const PERSONNEL_SOURCE_SHEET_COLUMN = '來源分頁名稱';
const SOURCE_PERSONNEL_UNIT_COLUMN = '費用單位';

const TARGET_PERSONNEL_SHEET_NAME = '1.1_部門人事預算_會科';
const SOURCE_NON_PERSONNEL_SHEET_NAME = '0.2_部門非人事預算';
const TARGET_SUMMARY_SHEET_NAME = '1.2_部門預算匯總_會科';
const SHARED_ALLOCATION_MAPPING_SHEET_NAME = '共用資源分攤 Mapping 表';
const SHARED_ALLOCATION_SHEET_NAME = '1.3_共用攤分後匯總_會科';
const FINAL_SUMMARY_SPREADSHEET_ID = '1Vj6zhZ_mmalw3YX5ncpiETkvdMnoT21Yzbp4-YqTJTU';
const FINAL_SUMMARY_SHEET_NAME = '各部費用清單';

function runPersonnelExpenseFill() {
  fillPersonnelExpenseByMapping_();
}

function runAllExpenseSummary() {
  fillPersonnelExpenseByMapping_();
  consolidateAllExpenses_();
}

function runFinalSummaryExport() {
  consolidateFinalSummary_();
}

function runSharedResourceAllocation() {
  allocateSharedResources_();
}

function fillPersonnelExpenseByMapping_() {
  const sourceSetting = loadPersonnelSourceSetting_();
  const sourceSpreadsheet = SpreadsheetApp.openById(sourceSetting.spreadsheetId);
  const sourceSheet = sourceSpreadsheet.getSheetByName(sourceSetting.sheetName);
  if (!sourceSheet) {
    throw new Error(`找不到來源分頁：${sourceSetting.sheetName}`);
  }

  const dataset = readSheetDataset_(sourceSheet);
  if (!dataset.header.length) {
    throw new Error(`來源分頁缺少標題列：${sourceSetting.sheetName}`);
  }

  const headerMap = buildHeaderMap_(dataset.header);
  const unitIndex = headerMap[normalizeString_(SOURCE_PERSONNEL_UNIT_COLUMN)];
  if (typeof unitIndex !== 'number') {
    throw new Error(`找不到欄位：${SOURCE_PERSONNEL_UNIT_COLUMN}`);
  }

  const mappingRows = loadMappingRows_();
  const mappingByUnit = buildMappingByUnit_(mappingRows);
  const rowsByTarget = groupRowsByTarget_(dataset.rows, unitIndex, mappingByUnit);

  rowsByTarget.forEach((rows, targetKey) => {
    const [spreadsheetId, sheetName] = targetKey.split('|');
    writeRowsAlignedToTarget_(spreadsheetId, sheetName, dataset.header, rows);
  });
}

function consolidateAllExpenses_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const personnelSheet = ss.getSheetByName(TARGET_PERSONNEL_SHEET_NAME);
  const nonPersonnelSheet = ss.getSheetByName(SOURCE_NON_PERSONNEL_SHEET_NAME);
  const targetSheet = ss.getSheetByName(TARGET_SUMMARY_SHEET_NAME);

  if (!personnelSheet) {
    throw new Error(`找不到來源分頁：${TARGET_PERSONNEL_SHEET_NAME}`);
  }
  if (!nonPersonnelSheet) {
    throw new Error(`找不到來源分頁：${SOURCE_NON_PERSONNEL_SHEET_NAME}`);
  }
  if (!targetSheet) {
    throw new Error(`找不到目標分頁：${TARGET_SUMMARY_SHEET_NAME}`);
  }

  const personnelDataset = readSheetDataset_(personnelSheet);
  const nonPersonnelDataset = readSheetDataset_(nonPersonnelSheet);
  const combinedHeader = personnelDataset.header.length
    ? personnelDataset.header
    : nonPersonnelDataset.header;

  if (!combinedHeader.length) {
    throw new Error('來源分頁缺少標題列');
  }

  const combinedRows = [];
  combinedRows.push(...personnelDataset.rows);
  combinedRows.push(...nonPersonnelDataset.rows);

  writeRowsAlignedToTarget_(ss.getId(), TARGET_SUMMARY_SHEET_NAME, combinedHeader, combinedRows);
}

function consolidateFinalSummary_() {
  const mappingRows = loadMappingRows_();
  const destinationIds = extractDestinationIds_(mappingRows);
  if (!destinationIds.length) {
    throw new Error('Mapping 分頁缺少目的地 Spreadsheet ID');
  }

  let header = null;
  const aggregatedRows = [];

  destinationIds.forEach(spreadsheetId => {
    const dataset = loadSourceDataset_(spreadsheetId, TARGET_SUMMARY_SHEET_NAME);
    if (!dataset.header.length) return;

    if (!header || !header.length) header = dataset.header;
    aggregatedRows.push(...dataset.rows);
  });

  if (!header || !header.length) {
    throw new Error('來源分頁缺少標題列');
  }

  writeRowsAlignedToTarget_(FINAL_SUMMARY_SPREADSHEET_ID, FINAL_SUMMARY_SHEET_NAME, header, aggregatedRows);
}

function allocateSharedResources_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sourceSheet = ss.getSheetByName(TARGET_SUMMARY_SHEET_NAME);
  const targetSheet = ss.getSheetByName(SHARED_ALLOCATION_SHEET_NAME);

  if (!sourceSheet) {
    throw new Error(`找不到來源分頁：${TARGET_SUMMARY_SHEET_NAME}`);
  }
  if (!targetSheet) {
    throw new Error(`找不到目標分頁：${SHARED_ALLOCATION_SHEET_NAME}`);
  }

  const sourceDataset = readSheetDataset_(sourceSheet);
  if (!sourceDataset.header.length) {
    throw new Error(`來源分頁缺少標題列：${TARGET_SUMMARY_SHEET_NAME}`);
  }

  const mappingDataset = loadSharedAllocationMapping_();
  const allocationRules = buildSharedAllocationRules_(mappingDataset);

  const headerMap = buildHeaderMap_(sourceDataset.header);
  const departmentIndex = requireHeaderIndexCandidates_(headerMap, [
    '費用單位',
    '費用部門'
  ]);
  const productLineIndex = requireHeaderIndex_(headerMap, '產品線');
  const taIndex = requireHeaderIndex_(headerMap, 'TA 編號');
  const monthIndices = resolveMonthColumnIndices_(sourceDataset.header);
  if (!monthIndices.length) {
    throw new Error('找不到每月金額欄位，請確認 1.2 欄位名稱是否包含月份');
  }
  const yearTotalColumns = resolveYearTotalColumns_(sourceDataset.header);
  const monthsByYear = buildMonthIndicesByYear_(sourceDataset.header, monthIndices);

  const outputRows = [];

  sourceDataset.rows.forEach(row => {
    const key = buildAllocationKey_(
      row[departmentIndex],
      row[productLineIndex],
      row[taIndex]
    );

    const rules = allocationRules.get(key);
    if (!rules || !rules.length) {
      const passthroughRow = row.slice();
      applyYearTotals_(passthroughRow, monthIndices, monthsByYear, yearTotalColumns);
      outputRows.push(passthroughRow);
      return;
    }

    rules.forEach(rule => {
      const newRow = row.slice();
      newRow[departmentIndex] = rule.targetDepartment;
      newRow[productLineIndex] = rule.targetProductLine;
      newRow[taIndex] = rule.targetTa;

      monthIndices.forEach(index => {
        const value = Number(row[index]);
        const baseValue = Number.isFinite(value) ? value : 0;
        newRow[index] = baseValue * rule.ratio;
      });

      applyYearTotals_(newRow, monthIndices, monthsByYear, yearTotalColumns);
      outputRows.push(newRow);
    });
  });

  writeRowsAlignedToTarget_(ss.getId(), SHARED_ALLOCATION_SHEET_NAME, sourceDataset.header, outputRows);
}

function loadMappingRows_() {
  const mappingSpreadsheet = SpreadsheetApp.openById(CONTROL_SPREADSHEET_ID);
  const mappingSheet = mappingSpreadsheet.getSheetByName(MAPPING_SHEET_NAME);
  if (!mappingSheet) {
    throw new Error(`找不到 Mapping 分頁：${MAPPING_SHEET_NAME}`);
  }

  const dataset = readSheetDataset_(mappingSheet);
  if (!dataset.header.length) {
    throw new Error(`Mapping 分頁缺少標題列：${MAPPING_SHEET_NAME}`);
  }

  return dataset;
}

function loadSharedAllocationMapping_() {
  const mappingSpreadsheet = SpreadsheetApp.openById(CONTROL_SPREADSHEET_ID);
  const mappingSheet = mappingSpreadsheet.getSheetByName(SHARED_ALLOCATION_MAPPING_SHEET_NAME);
  if (!mappingSheet) {
    throw new Error(`找不到 Mapping 分頁：${SHARED_ALLOCATION_MAPPING_SHEET_NAME}`);
  }

  const dataset = readSheetDataset_(mappingSheet);
  if (!dataset.header.length) {
    throw new Error(`Mapping 分頁缺少標題列：${SHARED_ALLOCATION_MAPPING_SHEET_NAME}`);
  }

  return dataset;
}

function extractDestinationIds_(dataset) {
  const headerMap = buildHeaderMap_(dataset.header);
  const targetIdIndex = headerMap[normalizeString_('目的地 Spreadsheet ID')];
  if (targetIdIndex === undefined) return [];

  const ids = new Set();
  dataset.rows.forEach(row => {
    const spreadsheetId = normalizeString_(row[targetIdIndex]);
    if (spreadsheetId) ids.add(spreadsheetId);
  });

  return Array.from(ids);
}

function buildSharedAllocationRules_(dataset) {
  const headerMap = buildHeaderMap_(dataset.header);
  const sourceDepartmentIndex = resolveHeaderIndex_(headerMap, [
    '來源費用單位',
    '來源費用部門',
    '費用單位',
    '費用部門'
  ]);
  const sourceProductLineIndex = resolveHeaderIndex_(headerMap, [
    '來源產品線',
    '產品線'
  ]);
  const sourceTaIndex = resolveHeaderIndex_(headerMap, [
    '來源TA 編號',
    '來源 TA 編號',
    'TA 編號'
  ]);
  const ratioIndex = resolveHeaderIndex_(headerMap, [
    '金額拆分比例',
    '拆分比例',
    '分攤比例'
  ]);
  const targetDepartmentIndex = resolveHeaderIndex_(headerMap, [
    '拆分後費用單位',
    '拆分後費用部門',
    '目標費用單位',
    '目標費用部門',
    '費用單位(拆分後)',
    '費用部門(拆分後)',
    '費用單位_拆分後',
    '費用部門_拆分後'
  ]);
  const targetProductLineIndex = resolveHeaderIndex_(headerMap, [
    '拆分後產品線',
    '目標產品線',
    '產品線(拆分後)',
    '產品線_拆分後'
  ]);
  const targetTaIndex = resolveHeaderIndex_(headerMap, [
    '拆分後 TA 編號',
    '拆分後TA 編號',
    '目標 TA 編號',
    '目標TA 編號',
    'TA 編號(拆分後)',
    'TA 編號_拆分後'
  ]);

  if (
    sourceDepartmentIndex === undefined ||
    sourceProductLineIndex === undefined ||
    sourceTaIndex === undefined ||
    ratioIndex === undefined ||
    targetDepartmentIndex === undefined ||
    targetProductLineIndex === undefined ||
    targetTaIndex === undefined
  ) {
    throw new Error('共用資源分攤 Mapping 表缺少必要欄位');
  }

  const mapping = new Map();
  const ratioTotals = new Map();

  dataset.rows.forEach(row => {
    const sourceKey = buildAllocationKey_(
      row[sourceDepartmentIndex],
      row[sourceProductLineIndex],
      row[sourceTaIndex]
    );
    if (!sourceKey) return;

    const ratio = parseRatio_(row[ratioIndex]);
    if (!Number.isFinite(ratio) || ratio <= 0) return;

    const targetDepartment = normalizeString_(row[targetDepartmentIndex]);
    const targetProductLine = normalizeString_(row[targetProductLineIndex]);
    const targetTa = normalizeString_(row[targetTaIndex]);
    if (!targetDepartment || !targetProductLine || !targetTa) return;

    if (!mapping.has(sourceKey)) mapping.set(sourceKey, []);
    mapping.get(sourceKey).push({
      ratio,
      targetDepartment,
      targetProductLine,
      targetTa
    });

    const total = (ratioTotals.get(sourceKey) || 0) + ratio;
    ratioTotals.set(sourceKey, total);
  });

  ratioTotals.forEach((total, sourceKey) => {
    if (Math.abs(total - 1) > 0.01) {
      Logger.log(`共用資源分攤比例加總不等於 1：${sourceKey} = ${total}`);
    }
  });

  return mapping;
}

function loadSourceDataset_(spreadsheetId, sheetName) {
  const ss = SpreadsheetApp.openById(spreadsheetId);
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet) throw new Error(`找不到來源分頁：${sheetName}`);

  const dataset = readSheetDataset_(sheet);
  if (!dataset.header.length) {
    throw new Error(`來源分頁缺少標題列：${sheetName}`);
  }
  return dataset;
}

function resolveMonthColumnIndices_(header) {
  const indices = [];
  header.forEach((name, index) => {
    if (name instanceof Date) {
      indices.push(index);
      return;
    }
    const key = normalizeString_(name);
    if (!key) return;
    const compactKey = key.replace(/\s+/g, '');
    if (
      /^\d{4}\/\d{1,2}$/.test(key) ||
      /^\d{4}\/\d{1,2}$/.test(compactKey) ||
      /^\d{1,2}月$/.test(key) ||
      /^\d{1,2}月金額$/.test(key) ||
      /^\d{1,2}月/.test(key) ||
      /^\d{1,2}月/.test(compactKey) ||
      /^M\d{1,2}$/i.test(key) ||
      /^Month\d{1,2}$/i.test(key) ||
      /^(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)$/i.test(key) ||
      /^(一|二|三|四|五|六|七|八|九|十|十一|十二)月$/.test(key) ||
      /^(一|二|三|四|五|六|七|八|九|十|十一|十二)月/.test(compactKey)
    ) {
      indices.push(index);
    }
  });
  return indices;
}

function resolveYearTotalColumns_(header) {
  const columns = [];
  header.forEach((name, index) => {
    const key = normalizeString_(name);
    if (!key) return;
    const match = key.match(/^(\d{4})\s*(year|年度|年)$/i);
    if (!match) return;
    columns.push({ index, year: Number(match[1]) });
  });
  return columns;
}

function buildMonthIndicesByYear_(header, monthIndices) {
  const map = new Map();
  monthIndices.forEach(index => {
    const value = header[index];
    const year = extractYearFromMonthHeader_(value);
    if (!year) return;
    if (!map.has(year)) map.set(year, []);
    map.get(year).push(index);
  });
  return map;
}

function extractYearFromMonthHeader_(value) {
  if (value instanceof Date) {
    return value.getFullYear();
  }
  const text = normalizeString_(value);
  if (!text) return 0;
  const compact = text.replace(/\s+/g, '');
  const match = compact.match(/^(\d{4})[\/\-](\d{1,2})$/);
  if (match) return Number(match[1]);
  return 0;
}

function applyYearTotals_(row, monthIndices, monthsByYear, yearTotalColumns) {
  if (!yearTotalColumns.length) return;
  yearTotalColumns.forEach(({ index, year }) => {
    const indices = monthsByYear.get(year) || monthIndices;
    const total = indices.reduce((sum, monthIndex) => {
      const value = Number(row[monthIndex]);
      return sum + (Number.isFinite(value) ? value : 0);
    }, 0);
    row[index] = total;
  });
}


function buildAllocationKey_(department, productLine, taId) {
  const deptKey = normalizeString_(department);
  const plKey = normalizeString_(productLine);
  const taKey = normalizeString_(taId);
  if (!deptKey || !plKey || !taKey) return '';
  return `${deptKey}|${plKey}|${taKey}`;
}

function parseRatio_(value) {
  if (value === null || value === undefined || value === '') return NaN;
  if (typeof value === 'number') return value;
  const text = String(value).trim();
  if (!text) return NaN;
  if (text.endsWith('%')) {
    const num = Number(text.replace('%', '').trim());
    return Number.isFinite(num) ? num / 100 : NaN;
  }
  const parsed = Number(text);
  return Number.isFinite(parsed) ? parsed : NaN;
}

function resolveHeaderIndex_(headerMap, candidates) {
  for (const name of candidates) {
    const index = headerMap[normalizeString_(name)];
    if (index !== undefined) return index;
  }
  return undefined;
}

function requireHeaderIndex_(headerMap, name) {
  const index = headerMap[normalizeString_(name)];
  if (index === undefined) {
    throw new Error(`找不到欄位：${name}`);
  }
  return index;
}

function requireHeaderIndexCandidates_(headerMap, candidates) {
  for (const name of candidates) {
    const index = headerMap[normalizeString_(name)];
    if (index !== undefined) return index;
  }
  throw new Error(`找不到欄位：${candidates.join(' / ')}`);
}

function loadPersonnelSourceSetting_() {
  const mappingSpreadsheet = SpreadsheetApp.openById(CONTROL_SPREADSHEET_ID);
  const settingSheet = mappingSpreadsheet.getSheetByName(PERSONNEL_SETTING_SHEET_NAME);
  if (!settingSheet) {
    throw new Error(`找不到設定分頁：${PERSONNEL_SETTING_SHEET_NAME}`);
  }

  const dataset = readSheetDataset_(settingSheet);
  if (!dataset.header.length || !dataset.rows.length) {
    throw new Error(`設定分頁缺少資料：${PERSONNEL_SETTING_SHEET_NAME}`);
  }

  const headerMap = buildHeaderMap_(dataset.header);
  const idIndex = headerMap[normalizeString_(PERSONNEL_SOURCE_ID_COLUMN)];
  const sheetIndex = headerMap[normalizeString_(PERSONNEL_SOURCE_SHEET_COLUMN)];
  if (idIndex === undefined || sheetIndex === undefined) {
    throw new Error(`設定分頁缺少欄位：${PERSONNEL_SOURCE_ID_COLUMN} / ${PERSONNEL_SOURCE_SHEET_COLUMN}`);
  }

  const firstRow = dataset.rows[0] || [];
  const spreadsheetId = normalizeString_(firstRow[idIndex]);
  const sheetName = normalizeString_(firstRow[sheetIndex]);
  if (!spreadsheetId || !sheetName) {
    throw new Error('設定分頁的第一列資料不完整');
  }

  return { spreadsheetId, sheetName };
}

function buildMappingByUnit_(dataset) {
  const headerMap = buildHeaderMap_(dataset.header);
  const unitIndex = headerMap[normalizeString_('費用單位')];
  const targetIdIndex = headerMap[normalizeString_('目的地 Spreadsheet ID')];
  const targetSheetIndex = headerMap[normalizeString_('目的地分頁名稱')];

  if (unitIndex === undefined || targetIdIndex === undefined || targetSheetIndex === undefined) {
    throw new Error('Mapping 分頁缺少必要欄位：費用單位 / 目的地 Spreadsheet ID / 目的地分頁名稱');
  }

  const mapping = new Map();
  dataset.rows.forEach(row => {
    const unit = normalizeString_(row[unitIndex]);
    const spreadsheetId = normalizeString_(row[targetIdIndex]);
    const sheetName = normalizeString_(row[targetSheetIndex]);
    if (!unit || !spreadsheetId || !sheetName) return;
    mapping.set(unit, { spreadsheetId, sheetName });
  });

  return mapping;
}

function groupRowsByTarget_(rows, unitIndex, mappingByUnit) {
  const grouped = new Map();

  rows.forEach(row => {
    const unit = normalizeString_(row[unitIndex]);
    if (!unit || !mappingByUnit.has(unit)) return;
    const mapping = mappingByUnit.get(unit);
    const key = `${mapping.spreadsheetId}|${mapping.sheetName}`;
    if (!grouped.has(key)) grouped.set(key, []);
    grouped.get(key).push(row);
  });

  return grouped;
}

function readSheetDataset_(sheet) {
  const lastRow = sheet.getLastRow();
  const lastColumn = sheet.getLastColumn();
  if (lastRow < 1 || lastColumn < 1) return { header: [], rows: [] };

  const header = sheet.getRange(1, 1, 1, lastColumn).getValues()[0];
  const rows = lastRow > 1
    ? sheet.getRange(2, 1, lastRow - 1, lastColumn).getValues()
    : [];

  return { header, rows };
}

function writeRowsAlignedToTarget_(spreadsheetId, sheetName, sourceHeader, rows) {
  const ss = SpreadsheetApp.openById(spreadsheetId);
  const sheet = ss.getSheetByName(sheetName);
  if (!sheet) throw new Error(`找不到目標分頁：${sheetName}`);

  const lastColumn = sheet.getLastColumn();
  if (lastColumn < 1) {
    throw new Error(`目標分頁缺少標題列：${sheetName}`);
  }

  const targetHeader = sheet.getRange(1, 1, 1, lastColumn).getValues()[0];
  if (!targetHeader.length) {
    throw new Error(`目標分頁缺少標題列：${sheetName}`);
  }

  const targetHeaderMap = buildHeaderMap_(targetHeader);
  const columnMappings = sourceHeader.reduce((acc, name, index) => {
    const key = normalizeString_(name);
    if (!key) return acc;
    if (!Object.prototype.hasOwnProperty.call(targetHeaderMap, key)) return acc;
    acc.push({
      sourceIndex: index,
      targetColumn: targetHeaderMap[key] + 1
    });
    return acc;
  }, []);

  if (!columnMappings.length) return;

  ensureCapacity_(sheet, rows.length + 1, sheet.getMaxColumns());
  const maxRows = sheet.getMaxRows();
  columnMappings.forEach(({ targetColumn }) => {
    if (maxRows > 1) {
      const targetRange = sheet.getRange(2, targetColumn, maxRows - 1, 1);
      targetRange.clearDataValidations();
      targetRange.clearContent();
    }
  });

  if (!rows.length) return;

  columnMappings.forEach(({ sourceIndex, targetColumn }) => {
    const columnValues = rows.map(row => {
      const value = row[sourceIndex];
      return [value === undefined ? '' : value];
    });
    sheet.getRange(2, targetColumn, columnValues.length, 1).setValues(columnValues);
  });
}

function ensureCapacity_(sheet, requiredRows, requiredColumns) {
  const currentMaxRows = sheet.getMaxRows();
  if (currentMaxRows < requiredRows) {
    sheet.insertRowsAfter(currentMaxRows, requiredRows - currentMaxRows);
  }

  const currentMaxColumns = sheet.getMaxColumns();
  if (currentMaxColumns < requiredColumns) {
    sheet.insertColumnsAfter(currentMaxColumns, requiredColumns - currentMaxColumns);
  }
}

function normalizeString_(value) {
  if (value === null || value === undefined) return '';
  if (typeof value === 'string') return value.trim();
  return String(value).trim();
}

function buildHeaderMap_(header) {
  const map = Object.create(null);
  if (!Array.isArray(header)) return map;

  header.forEach((name, index) => {
    const key = normalizeString_(name);
    if (!key) return;
    if (!Object.prototype.hasOwnProperty.call(map, key)) {
      map[key] = index;
    }
  });

  return map;
}
